# Copy to .env for local dev if you want to override the API origin.
# When unset, the app calls "/api" which the Vite dev server proxies to
# http://localhost:5000 (see vite.config.js). For a deployed build point this
# at your live backend, e.g. https://your-api.onrender.com/api
VITE_API_URL=/api

# Note: Cloudinary credentials live on the BACKEND (.env of the API
# server), not here — the browser never sees them. Uploads go via
# POST /api/upload which forwards to Cloudinary using the signed SDK.
